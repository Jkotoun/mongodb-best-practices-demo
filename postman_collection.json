{
  "info": {
    "name": "MongoDB Testing — NestJS API",
    "description": "Order/product/supplier/review showcase API. Run requests top-to-bottom: each create captures its _id into a collection variable so later requests chain automatically.\n\nFlow: Create Supplier -> Create Product (uses supplierId) -> Add Review (uses productId) -> Create Order (uses productId). Then GETs.\n\nChange `baseUrl` if your app is not on http://localhost:4000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "userId", "value": "507f1f77bcf86cd799439011" },
    { "key": "supplierId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "reviewId", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "Suppliers",
      "item": [
        {
          "name": "Create Supplier",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json._id) {",
                  "  pm.collectionVariables.set('supplierId', json._id);",
                  "  console.log('supplierId =', json._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/suppliers", "host": ["{{baseUrl}}"], "path": ["suppliers"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Components\",\n  \"contactEmail\": \"sales@acme.example\",\n  \"country\": \"US\"\n}"
            }
          }
        },
        {
          "name": "Get Supplier by Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/suppliers/{{supplierId}}", "host": ["{{baseUrl}}"], "path": ["suppliers", "{{supplierId}}"] }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Create Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json._id) {",
                  "  pm.collectionVariables.set('productId', json._id);",
                  "  console.log('productId =', json._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mechanical Keyboard\",\n  \"price\": 89.99,\n  \"stock\": 50,\n  \"supplierId\": \"{{supplierId}}\"\n}"
            }
          }
        },
        {
          "name": "Get Product by Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}"] }
          }
        },
        {
          "name": "Get Product by Id (with supplier)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}?withSupplier=true",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"],
              "query": [{ "key": "withSupplier", "value": "true" }]
            }
          }
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "Add Review",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const id = json && (json._id || (json.topReviews && json.topReviews[0] && json.topReviews[0].reviewId));",
                  "if (id) {",
                  "  pm.collectionVariables.set('reviewId', id);",
                  "  console.log('reviewId =', id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "reviews"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"rating\": 5,\n  \"comment\": \"Great tactile feel, fast shipping.\"\n}"
            }
          }
        },
        {
          "name": "List Reviews (paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/reviews?page=1&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "reviews"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "5" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json._id) {",
                  "  pm.collectionVariables.set('orderId', json._id);",
                  "  console.log('orderId =', json._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 2 }\n  ]\n}"
            }
          }
        },
        {
          "name": "Get Order by Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["orders", "{{orderId}}"] }
          }
        },
        {
          "name": "Search Orders (by userId + productName)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders?userId={{userId}}&productName=Mechanical Keyboard",
              "host": ["{{baseUrl}}"],
              "path": ["orders"],
              "query": [
                { "key": "userId", "value": "{{userId}}" },
                { "key": "productName", "value": "Mechanical Keyboard" }
              ]
            }
          }
        }
      ]
    }
  ]
}
