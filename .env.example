MONGO_URL=mongodb://admin:secret@localhost:27017/admin?authSource=admin

# GcpOidcGuard is bypassed for local/test/development; set to "production"
# to enforce verification of a Google-signed OIDC bearer token.
NODE_ENV=local
# Audience the OIDC token must be issued for (e.g. the Cloud Run service URL).
# Required only when NODE_ENV=production.
OIDC_AUDIENCE=
